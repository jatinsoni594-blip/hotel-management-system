            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomNumber\": \"501\",\n  \"type\": \"Skyline Panoramic Suite\",\n  \"category\": \"Suite\",\n  \"floor\": 5,\n  \"pricePerNight\": 8499,\n  \"capacity\": 3,\n  \"bedType\": \"King Bed\",\n  \"amenities\": [\"Private Balcony\", \"Panoramic City View\", \"Smart TV\", \"Mini Bar\", \"Complimentary Breakfast\"],\n  \"description\": \"Luxurious top-floor suite with uninterrupted skyline vistas and soaking tub.\"\n}"
            },
            "url": {
