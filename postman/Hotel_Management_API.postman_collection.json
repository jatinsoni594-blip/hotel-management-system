        {
          "name": "Filter Rooms (Available & Deluxe)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5000/api/rooms?status=Available&category=Deluxe",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5001",
              "path": ["api", "rooms"],
              "query": [
                { "key": "status", "value": "Available" },
                { "key": "category", "value": "Deluxe" }
